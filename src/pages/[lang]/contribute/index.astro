---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useTranslations, type Lang } from '../../../i18n/utils';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }];
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t('contrib.title')} description={t('contrib.subtitle')}>
  <div class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
    <h1 class="font-serif-cn text-3xl font-bold text-ink-900">{t('contrib.title')}</h1>
    <p class="mt-4 leading-relaxed text-ink-600">{t('contrib.subtitle')}</p>

    <div class="mt-10 space-y-6">
      <section class="rounded-2xl border border-ink-100 bg-white p-6">
        <h2 class="font-serif-cn text-lg font-bold text-ink-900">{t('contrib.howto')}</h2>
        <ol class="mt-4 list-decimal space-y-2 pl-5 text-sm leading-relaxed text-ink-700">
          <li>{t('contrib.howto.1')}</li>
          <li>{t('contrib.howto.2')}</li>
          <li>{t('contrib.howto.3')}</li>
          <li>{t('contrib.howto.4')}</li>
        </ol>
      </section>

      <section class="rounded-2xl border border-ink-100 bg-white p-6">
        <h2 class="font-serif-cn text-lg font-bold text-ink-900">{t('contrib.license.title')}</h2>
        <p class="mt-3 text-sm leading-relaxed text-ink-700">{t('contrib.license.desc')}</p>
      </section>

      <section id="feedback" class="scroll-mt-20 rounded-2xl border border-gold-200 bg-gold-50 p-6">
        <h2 class="font-serif-cn text-lg font-bold text-ink-900">{t('contrib.feedback.title')}</h2>
        <p class="mt-3 text-sm leading-relaxed text-ink-700">{t('contrib.feedback.desc')}</p>
        <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm text-ink-700">
          <li>{t('contrib.feedback.1')}</li>
          <li>{t('contrib.feedback.2')}</li>
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>
