---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeritageCard from '../../components/HeritageCard.astro';
import DirectoryFilters from '../../components/DirectoryFilters.astro';
import { getHeritageList } from '../../lib/heritage';
import { useTranslations, type Lang } from '../../i18n/utils';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }];
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
const all = await getHeritageList();
---

<BaseLayout lang={lang} title={t('dir.title')} description={t('dir.subtitle').replace('{count}', String(all.length))}>
  <div class="border-b border-ink-100 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
      <h1 class="font-serif-cn text-3xl font-bold text-ink-900">{t('dir.title')}</h1>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-ink-500">{t('dir.subtitle').replace('{count}', String(all.length))}</p>
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <DirectoryFilters lang={lang} />
  </div>

  <div class="mx-auto max-w-6xl px-4 pb-12 sm:px-6">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {all.map((h) => <HeritageCard heritage={h} />)}
    </div>
  </div>
</BaseLayout>
