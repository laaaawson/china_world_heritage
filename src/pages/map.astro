---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeritageMap from '../components/HeritageMap.astro';
import { getHeritageList } from '../lib/heritage';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const all = await getHeritageList();
const legend = [
  { key: '文化遗产', color: '#C2542F' },
  { key: '自然遗产', color: '#2E7D32' },
  { key: '双重遗产', color: '#4A6FA5' },
];
---

<BaseLayout lang={lang} title={t('map.title')} description={t('map.subtitle').replace('{count}', String(all.length))}>
  <div class="border-b border-ink-100 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
      <h1 class="font-serif-cn text-3xl font-bold text-ink-900">{t('map.title')}</h1>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-ink-500">{t('map.subtitle').replace('{count}', String(all.length))}</p>
      <div class="mt-6 flex flex-wrap items-center gap-4 text-sm text-ink-600">
        {
          legend.map((l) => (
            <span class="inline-flex items-center gap-1.5">
              <span class="h-2.5 w-2.5 rounded-full" style={`background:${l.color}`}></span>
              {t(`cat.${l.key === '文化遗产' ? 'cultural' : l.key === '自然遗产' ? 'natural' : 'mixed'}`)}
            </span>
          ))
        }
        <a
          href={lang === 'en' ? '/en/directory/' : '/directory/'}
          class="ml-auto font-medium text-gold-700 transition-colors hover:text-gold-600"
        >
          {t('view.all')} →
        </a>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <HeritageMap lang={lang} />
    <p class="mt-4 text-xs text-ink-400">{t('map.note')}</p>
  </div>
</BaseLayout>
