---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  timeline: { period: string; title: string; desc?: string }[];
  lang?: Lang;
}

const { timeline, lang = 'zh' } = Astro.props;
const t = useTranslations(lang);
const stepsLabel = lang === 'zh' ? `${timeline.length} 个关键节点` : `${timeline.length} key moments`;
---

{
  timeline.length > 0 && (
    <section class="mt-6 overflow-hidden rounded-2xl border border-ink-100 bg-white shadow-sm">
      <div class="flex items-center justify-between border-b border-ink-100 bg-ink-900 px-5 py-2.5">
        <h2 class="font-serif-cn text-sm font-bold tracking-wide text-gold-300">{t('detail.timeline')}</h2>
        <span class="text-xs text-ink-400">{stepsLabel}</span>
      </div>
      <ol class="grid gap-px bg-ink-100 sm:grid-cols-2">
        {
          timeline.map((item, i) => (
            <li class="group bg-paper-50 p-4 transition-colors hover:bg-gold-50">
              <div class="flex items-center gap-2">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-gold-200 font-serif-cn text-[11px] font-bold text-gold-800">
                  {i + 1}
                </span>
                <span class="rounded bg-ink-800 px-1.5 py-0.5 font-serif-cn text-[11px] font-bold text-gold-300">
                  {item.period}
                </span>
              </div>
              <h3 class="mt-2 font-serif-cn text-sm font-bold text-ink-900 group-hover:text-ink-700">{item.title}</h3>
              {item.desc && <p class="mt-1 text-xs leading-relaxed text-ink-600">{item.desc}</p>}
            </li>
          ))
        }
      </ol>
    </section>
  )
}
