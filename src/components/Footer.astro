---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang?: Lang;
}

const lang = Astro.props.lang ?? 'zh';
const t = useTranslations(lang);
const year = new Date().getFullYear();
const navHref = (p: string) => (lang === 'en' ? `/en${p}` : p);
---

<footer class="border-t border-ink-100 bg-ink-900 text-ink-200">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:px-6 md:grid-cols-3">
    <div>
      <p class="font-serif-cn text-lg font-bold text-paper-100">{t('site.name')}</p>
      <p class="mt-2 text-sm leading-relaxed text-ink-300">{t('footer.desc')}</p>
    </div>
    <div>
      <p class="text-sm font-semibold text-paper-100">{t('footer.nav')}</p>
      <ul class="mt-2 space-y-1.5 text-sm">
        <li><a class="hover:text-gold-300" href={navHref('/directory/')}>{t('nav.directory')}</a></li>
        <li><a class="hover:text-gold-300" href={navHref('/topics/')}>{t('nav.topics')}</a></li>
        <li><a class="hover:text-gold-300" href={navHref('/contribute/')}>{t('nav.contribute')}</a></li>
      </ul>
    </div>
    <div>
      <p class="text-sm font-semibold text-paper-100">{t('footer.license')}</p>
      <p class="mt-2 text-sm leading-relaxed text-ink-300">{t('footer.license.desc')}</p>
      <p class="mt-3 text-sm">
        <a class="text-gold-300 underline decoration-gold-500/50 underline-offset-4 hover:text-gold-200" href={`${navHref('/contribute/')}#feedback`}>
          {t('footer.feedback')}
        </a>
      </p>
    </div>
  </div>
  <div class="border-t border-ink-800 py-4 text-center text-xs text-ink-400">
    © {year} {t('site.name')} · {t('footer.disclaimer')}
  </div>
</footer>
