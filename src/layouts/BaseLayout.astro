---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import { getLangFromUrl, useTranslations, type Lang } from '../i18n/utils';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  image?: string;
}

const { title, description, image } = Astro.props;
const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const fullTitle = title === t('nav.home') ? t('site.name') : `${title} · ${t('site.name')}`;
const defaultDescription = `${t('site.name')} —— ${t('site.slogan')}`;
const pageDescription = description ?? defaultDescription;
const site = 'https://china-world-heritage.pages.dev';
const pageUrl = new URL(Astro.url.pathname, site).toString();
const ogLocale = lang === 'en' ? 'en_US' : 'zh_CN';
const ogImage = image ? new URL(image, site).toString() : `${site}/favicon.svg`;

// hreflang 互指：中文路由无前缀，英文路由带 /en 前缀
const path = Astro.url.pathname;
const isEn = lang === 'en';
const zhPath = isEn ? (path.replace(/^\/en(?=\/|$)/, '') || '/') : path;
const enPath = isEn ? path : path === '/' ? '/en/' : `/en${path}`;
const zhUrl = new URL(zhPath, site).toString();
const enUrl = new URL(enPath, site).toString();
const htmlLang = lang === 'en' ? 'en' : 'zh-CN';

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site}/#website`,
  name: t('site.name'),
  alternateName: useTranslations(isEn ? 'zh' : 'en')('site.name'),
  url: `${site}/`,
  inLanguage: htmlLang,
  publisher: {
    '@type': 'Organization',
    '@id': `${site}/#organization`,
    name: t('site.name'),
    url: `${site}/`,
  },
};
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={pageUrl} />
    <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={zhUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t('site.name')} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header lang={lang} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <SearchOverlay lang={lang} />
    <script src="../scripts/visits.js" />
  </body>
</html>
